# ---------------- Python ----------------
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.installed.cfg

# ---------------- 虚拟环境 ----------------
.venv/
venv/
# README「代码检查」一节让建的独立 lint 环境（.venv-lint），别让它出现在 git status 里
.venv-lint/
env/
ENV/

# ---------------- 打包产物 ----------------
build/
dist/
*.spec
*.manifest

# ---------------- 运行数据 ----------------
# 工程根下这些目录是标定链路的输入与产物：体积大、可重新生成，一律不入库。
# 平时不存在也没关系——程序真正写入时才创建，不必提前铺一排空文件夹。
/calib_input/
/calib_preview/
/calib_data/
/ipm_input/
/ipm_output/
/matrix/
/lookup_table/
/test_input/
/test_output/

# data/ 只放两样东西：导入前的原始素材 与 备份压缩包
/data/

# 项目级配置（棋盘规格等）属于本机工作状态，不入库
/project.json

# 事务式导出用的暂存与回滚目录（正常情况下会被自动清掉，出现在这里说明上次异常退出）
*.staging/
*.old/

# ---------------- 编辑器 / 系统 ----------------
.vscode/
.ruff_cache/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------- Office 临时锁文件 ----------------
~$*
*.tmp

# ---------------- 本地代理记忆目录 ----------------
.workbuddy/
.workbuddy-ai/
